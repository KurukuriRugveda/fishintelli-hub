# ─── Server ──────────────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# For Render: set to /data/aqua_hub.db (Persistent Disk mounted at /data)
# For local:  set to ./aqua_hub.db
DATABASE_PATH=/data/aqua_hub.db

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Allowed frontend origins.
CORS_ORIGINS= http://localhost:5173/
