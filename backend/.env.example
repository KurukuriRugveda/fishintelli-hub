# ─── Server ──────────────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# For Render: set to your MongoDB Atlas connection string
# For local:  set to mongodb://localhost:27017/aqua_hub
MONGODB_URI=mongodb://localhost:27017/aqua_hub

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Allowed frontend origins.
CORS_ORIGINS= http://localhost:5173/
